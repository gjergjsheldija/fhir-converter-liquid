{
  "name": "fhir-converter-liquid",
  "version": "0.2.0",
  "description": "HL7v2 to FHIR R4 converter using Liquid templates",
  "main": "src/index.js",
  "engines": {
    "node": ">=26 <27"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gjergjsheldija/fhir-converter-liquid.git"
  },
  "bugs": {
    "url": "https://github.com/gjergjsheldija/fhir-converter-liquid/issues"
  },
  "homepage": "https://github.com/gjergjsheldija/fhir-converter-liquid#readme",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "env NODE_ENV=testing AI_OPENAI_API_KEY=test-mock-key NODE_OPTIONS=\"--import ./test/mocks/register-templategenerate-loader.mjs\" nyc node node_modules/mocha/bin/mocha.js --reporter-options configFile=mocha.config.json --exit --timeout 10000",
    "build": "npm install",
    "pretest": "node src/init-service.js",
    "posttest": "eslint {src,test}/**/*.js",
    "prestart": "node src/init-service.js",
    "start": "node src/index.js",
    "start:runtime": "node src/runtime.js",
    "convert:project": "node bin/convert.mjs",
    "eslint": "eslint {src,test}/**/*.js",
    "test:generate": "env NODE_ENV=testing AI_OPENAI_API_KEY=test-mock-key NODE_OPTIONS=\"--import ./test/mocks/register-templategenerate-loader.mjs\" node node_modules/.bin/nyc --exit --timeout 10000 node node_modules/mocha/bin/mocha.js src/routes.spec.js"
  },
  "eslintConfig": {
    "env": {
      "browser": true,
      "node": true,
      "mocha": true,
      "jquery": true,
      "es6": true
    },
    "globals": {
      "Split": "readonly",
      "Cookies": "readonly",
      "CodeMirror": "readonly"
    },
    "parserOptions": {
      "ecmaVersion": 13,
      "sourceType": "module"
    },
    "extends": "eslint:recommended",
    "rules": {
      "semi": [
        "error",
        "always"
      ],
      "indent": [
        "error",
        4,
        {
          "SwitchCase": 1
        }
      ]
    }
  },
  "nyc": {
    "check-coverage": false,
    "per-file": false,
    "lines": 90,
    "statements": 90,
    "functions": 90,
    "branches": 90,
    "include": [
      "@(src|test)/**/*.js"
    ],
    "exclude": [
      "**/*.spec.js"
    ],
    "reporter": [
      "text",
      "cobertura",
      "html"
    ],
    "report-dir": "./.test_output/coverage"
  },
  "mocha": {
    "reporter": "mocha-multi-reporters",
    "spec": "@(src|test)/**/*.spec.js",
    "slow": 100,
    "reporterOptions": {
      "reporterEnabled": "spec, blahblah",
      "xunitReporterOptions": {
        "output": ".test_output/xunit.xml"
      }
    }
  },
  "devDependencies": {
    "eslint": "^8.20.0",
    "mocha": "12.0.3",
    "mocha-junit-reporter": "^2.0.2",
    "mocha-multi-reporters": "^1.5.1",
    "nyc": "^15.1.0",
    "prettier": "^2.7.1",
    "supertest": "^6.2.4"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.1178.0",
    "ajv": "^8.11.0",
    "codemirror": "^5.59.2",
    "deepmerge": "^4.2.2",
    "express": "^4.18.1",
    "express-prom-bundle": "^6.5.0",
    "he": "^1.2.0",
    "js-yaml": "^4.1.0",
    "liquidjs": "^9.42.0",
    "lru-cache": "^11.5.3",
    "morgan": "^1.10.0",
    "piscina": "^5.3.2",
    "prom-client": "^14.0.1",
    "swagger-jsdoc": "^6.2.1",
    "swagger-ui-express": "^4.5.0",
    "winston": "^3.8.2",
    "xml2js": "0.5.0"
  }
}
