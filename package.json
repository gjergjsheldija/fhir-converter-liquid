{
  "name": "fhir-converter-liquid",
  "version": "0.1.0",
  "description": "HL7v2 to FHIR R4 converter using Liquid templates",
  "main": "src/index.js",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gjergjsheldija/fhir-converter-liquid.git"
  },
  "bugs": {
    "url": "https://github.com/gjergjsheldija/fhir-converter-liquid/issues"
  },
  "homepage": "https://github.com/gjergjsheldija/fhir-converter-liquid#readme",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "env NODE_ENV=testing nyc node node_modules/mocha/bin/_mocha --reporter-options configFile=mocha.config.json --exit --timeout 10000",
    "build": "npm install",
    "pretest": "node src/init-service.js",
    "posttest": "eslint {src,test}/**/*.js",
    "prestart": "node src/init-service.js",
    "start": "node src/index.js",
    "eslint": "eslint {src,test}/**/*.js",
    "prepare": "husky"
  },
  "eslintConfig": {
    "env": {
      "browser": true,
      "node": true,
      "mocha": true,
      "jquery": true,
      "es6": true
    },
    "globals": {
      "Split": "readonly",
      "Cookies": "readonly",
      "CodeMirror": "readonly"
    },
    "parserOptions": {
      "ecmaVersion": 13,
      "sourceType": "module"
    },
    "extends": "eslint:recommended",
    "rules": {
      "semi": [
        "error",
        "always"
      ],
      "indent": [
        "error",
        4,
        {
          "SwitchCase": 1
        }
      ]
    }
  },
  "eslintIgnore": [
    "src/lib/outputProcessor/autogen/*.js"
  ],
  "nyc": {
    "check-coverage": false,
    "per-file": false,
    "lines": 90,
    "statements": 90,
    "functions": 90,
    "branches": 90,
    "include": [
      "@(src|test)/**/*.js"
    ],
    "exclude": [
      "**/*.spec.js",
      "src/lib/outputProcessor/autogen/*.js"
    ],
    "reporter": [
      "text",
      "cobertura",
      "html"
    ],
    "report-dir": "./.test_output/coverage"
  },
  "mocha": {
    "reporter": "mocha-multi-reporters",
    "spec": "@(src|test)/**/*.spec.js",
    "slow": 100,
    "reporterOptions": {
      "reporterEnabled": "spec, blahblah",
      "xunitReporterOptions": {
        "output": ".test_output/xunit.xml"
      }
    }
  },
  "devDependencies": {
    "assert": "^2.0.0",
    "eslint": "^8.20.0",
    "husky": "^9.1.7",
    "mocha": "10.1.0",
    "mocha-junit-reporter": "^2.0.2",
    "mocha-multi-reporters": "^1.5.1",
    "nyc": "^15.1.0",
    "prettier": "^2.7.1",
    "split": "1.0.1",
    "supertest": "^6.2.4",
    "validator": "^13.7.0"
  },
  "dependencies": {
    "ajv": "^8.11.0",
    "antlr4": "4.10.1",
    "body-parser": "^1.20.0",
    "chai": "^4.3.10",
    "cls-hooked": "^4.2.2",
    "codemirror": "^5.59.2",
    "cookie-parser": "^1.4.6",
    "deepmerge": "^4.2.2",
    "express": "^4.18.1",
    "express-prom-bundle": "^6.5.0",
    "fhir": "^4.11.1",
    "fs-extra": "^10.1.0",
    "he": "^1.2.0",
    "iso-3166": "^4.1.0",
    "js-yaml": "^4.1.0",
    "liquidjs": "^9.42.0",
    "lodash": "^4.17.21",
    "memory-cache": "^0.2.0",
    "morgan": "^1.10.0",
    "nconf": "^0.12.0",
    "ncp": "^2.0.0",
    "prom-client": "^14.0.1",
    "promise": "^8.1.0",
    "rhea": "^3.0.1",
    "swagger-jsdoc": "^6.2.1",
    "swagger-ui-express": "^4.5.0",
    "tslib": "^2.4.0",
    "underscore": "^1.13.4",
    "uuid": "^8.3.2",
    "winston": "^3.8.2",
    "xml2js": "0.5.0"
  }
}
