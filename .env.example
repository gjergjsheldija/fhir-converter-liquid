# Server port
PORT=2019

# Conversion settings
CONVERSION_TIMEOUT_MS=30000

# Logging
LOG_LEVEL=info

# Convert API key (optional). When set, convert, project, browse, write, FHIR send/validate,
# template generation, field-map, and failure-log API routes require "Authorization: Bearer <key>".
# Leave empty to keep API routes open.
CONVERT_API_KEY=

# Headless cloud runtime mode (optional). Set to "true" or "1" to disable Web Studio UI,
# docs, guide, browse, and authoring routes, exposing only health/version/metrics,
# convert endpoints, and GET /api/v1/conversions/failures.
HEADLESS_RUNTIME=

# Root directory for deployed customer projects used by
# POST /api/v1/projects/:projectId/convert/:template (defaults to ./projects).
PROJECTS_ROOT=
