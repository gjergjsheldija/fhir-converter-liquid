{% assign genderCode = PID.8.Value -%}
{
    "fullUrl": "Patient/{{ ID }}",
    "resource": {
        "resourceType": "Patient",
        "id": "{{ ID }}",
        "identifier": [
            {
                "type": {
                    "coding": [
                        {
                            "system": "http://terminology.hl7.org/CodeSystem/v2-0203",
                            "code": "MR"
                        }
                    ]
                },
                "system": "https://fhir.example-hospital.org/sid/mrn",
                "value": "{{ PID.3.1.Value }}"
            }
        ],
        "name": [
            {
                "family": "{{ PID.5.1.Value }}",
                "given": [ "{{ PID.5.2.Value }}" ]
            }
        ],
        {% if genderCode == "M" -%}
        "gender": "male",
        {% elsif genderCode == "F" -%}
        "gender": "female",
        {% elsif genderCode == "O" or genderCode == "A" or genderCode == "X" -%}
        "gender": "other",
        {% elsif genderCode == "U" -%}
        "gender": "unknown",
        {% endif -%}
        {% if PID.7.Value -%}
        "birthDate": "{{ PID.7.Value | add_hyphens_date }}",
        {% endif -%}
        {% if PID.11.1.Value or PID.11.3.Value or PID.11.5.Value -%}
        "address": [
            {
                {% if PID.11.1.Value -%}
                "line": [ "{{ PID.11.1.Value }}" ],
                {% endif -%}
                "city": "{{ PID.11.3.Value }}",
                "state": "{{ PID.11.4.Value }}",
                "postalCode": "{{ PID.11.5.Value }}",
                "country": "{{ PID.11.6.Value }}",
            }
        ],
        {% endif -%}
    }
},
